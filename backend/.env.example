# CyberShield FastAPI Backend Environment Variables
# Copy to .env for local development, or configure in Railway / Render Dashboard Variables.
# NEVER commit real API keys or service account JSON files to GitHub.

# OpenRouter AI (NVIDIA Nemotron 3.5 Super VL)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Firebase Authentication Verification
FIREBASE_PROJECT_ID=cybersheild-30cc7
# Optional: paste raw or base64-encoded Firebase Admin service account JSON for Railway/Render
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Cloud Production Security & Storage
ALLOWED_ORIGINS=*
API_RATE_LIMIT_PER_MINUTE=120
# Optional: mount a persistent volume on Railway (/data) or Render (/var/data)
# CYBERSHIELD_DATA_DIR=/data
DISABLE_LAN_BEACON=1
